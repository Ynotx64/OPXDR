<group name="opxdr,opxdr_siem,telemetry,">
  <rule id="209300" level="3">
    <match>OPXDR_SIEM_TELEMETRY</match>
    <description>OPXDR SIEM agent telemetry heartbeat</description>
    <group>opxdr_siem,inventory,heartbeat,</group>
    <mitre>
      <id>T1082</id>
    </mitre>
  </rule>

  <rule id="209301" level="5">
    <if_sid>209300</if_sid>
    <match>kind=startup</match>
    <description>OPXDR SIEM agent startup telemetry received</description>
    <group>opxdr_siem,inventory,startup,</group>
    <mitre>
      <id>T1082</id>
    </mitre>
  </rule>

  <rule id="209302" level="6">
    <if_sid>209300</if_sid>
    <regex>listeners=[1-9][0-9]*</regex>
    <description>OPXDR SIEM agent active network services detected</description>
    <group>opxdr_siem,network,services,</group>
    <mitre>
      <id>T1049</id>
    </mitre>
  </rule>

  <rule id="209303" level="7">
    <if_sid>209300</if_sid>
    <regex>auth_events=[1-9][0-9]*</regex>
    <description>OPXDR SIEM agent authentication telemetry detected</description>
    <group>opxdr_siem,auth,credential_access,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="209304" level="6">
    <if_sid>209300</if_sid>
    <regex>processes=[1-9][0-9]*</regex>
    <description>OPXDR SIEM agent process telemetry detected</description>
    <group>opxdr_siem,process,execution,</group>
    <mitre>
      <id>T1057</id>
    </mitre>
  </rule>

  <rule id="209305" level="7">
    <if_sid>209300</if_sid>
    <regex>files=[1-9][0-9]*</regex>
    <description>OPXDR SIEM agent file integrity telemetry detected</description>
    <group>opxdr_siem,file_integrity,defense_evasion,</group>
    <mitre>
      <id>T1565.001</id>
    </mitre>
  </rule>

  <rule id="209306" level="8">
    <if_sid>209300</if_sid>
    <regex>honeypot_events=[1-9][0-9]*</regex>
    <description>OPXDR honeypot traffic observed on cloud agent</description>
    <group>opxdr_siem,honeypot,lab_or_external,medium,</group>
    <mitre>
      <id>T1110</id>
      <id>T1021.004</id>
    </mitre>
  </rule>

  <rule id="209309" level="8">
    <if_sid>209300</if_sid>
    <regex>real_external=true.*public_src_ips=[1-9][0-9]*|public_src_ips=[1-9][0-9]*.*real_external=true</regex>
    <description>Public internet source hit OPXDR honeypot decoy</description>
    <group>opxdr_siem,honeypot,real_external,medium,</group>
    <mitre>
      <id>T1190</id>
      <id>T1595.002</id>
    </mitre>
  </rule>

  <rule id="209307" level="10">
    <if_sid>209300</if_sid>
    <regex>honeypot_src_ips=[3-9][0-9]*|auth_failures=([5-9]|[1-9][0-9]+)|real_external=true.*(services_touched=[2-9]|exploit_marker=true)</regex>
    <description>Honeypot authentication failure burst, source diversity, or correlated public probing</description>
    <group>opxdr_siem,honeypot,credential_access,real_external,high,</group>
    <mitre>
      <id>T1110</id>
      <id>T1021.004</id>
    </mitre>
  </rule>

  <rule id="209308" level="10">
    <if_sid>209300</if_sid>
    <regex>honeypot_commands=([1-9]|[1-9][0-9]+)</regex>
    <description>Honeypot captured interactive command activity</description>
    <group>opxdr_siem,honeypot,execution,high,</group>
    <mitre>
      <id>T1059</id>
      <id>T1021.004</id>
    </mitre>
  </rule>

  <rule id="209310" level="15">
    <if_sid>209300</if_sid>
    <regex>real_external=true.*malware_retrieval_attempt=true.*contained_session=true</regex>
    <description>Critical isolated honeypot malware retrieval attempt</description>
    <group>opxdr_siem,honeypot,real_external,malware_retrieval,critical,</group>
    <mitre>
      <id>T1105</id>
      <id>T1059</id>
    </mitre>
  </rule>
</group>
