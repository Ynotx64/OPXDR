# ─── Wazuh API ────────────────────────────────────────────────────────────
# Default Wazuh API listens on 55000
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASS=change-me

# Set to "true" if your Wazuh API uses a self-signed cert (most installs do)
WAZUH_API_INSECURE=true

# ─── Wazuh Indexer (OpenSearch) — optional, for alert queries ────────────
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=change-me

# ─── Local rule sources ──────────────────────────────────────────────────
# Read-only browsing of staged rules
RULES_LOCAL_ROOT=/home/soc-admin/SecurityOperations/github-staging

# Where the app saves custom rules (writable by you)
CUSTOM_RULES_DIR=/home/soc-admin/SecurityOperations/custom_rules
CUSTOM_PLAYBOOKS_DIR=/home/soc-admin/SecurityOperations/custom_playbooks

# Where Wazuh actually loads rules from. The app writes a copy here too,
# so saving a new rule makes it live in Wazuh.
WAZUH_RULES_DIR=/var/ossec/etc/rules

# After saving a rule, call Wazuh API PUT /manager/restart automatically?
WAZUH_AUTO_RESTART=true

# ─── Wazuh alerts log (for SSE tail) ─────────────────────────────────────
WAZUH_ALERTS_LOG=/var/ossec/logs/alerts/alerts.json

# ─── AI provider (OpenCode / Anthropic) ──────────────────────────────────
# Pick ONE. If OPENCODE_API_KEY is set, that path is used.
OPENCODE_API_KEY=
OPENCODE_API_URL=https://api.opencode.ai/v1/messages
OPENCODE_MODEL=claude-sonnet-4-20250514

# Fallback direct Anthropic (only if OPENCODE_API_KEY is empty)
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── Slack notifications (real webhook, posts AI alert reports) ─────────
# Paste an Incoming Webhook URL from https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#soc-alerts
SLACK_USERNAME=OPXDR

# ─── AI auto-report (server-side, fires on every tailed alert) ──────────
# When true, the backend runs the AI agent on every new alert in alerts.json
# above MIN_LEVEL (12=HIGH, 15=CRITICAL) and posts the report to Slack.
AI_AUTO_REPORT=true
AI_AUTO_REPORT_MIN_LEVEL=12
AI_AUTO_SLACK_NOTIFY=true

# ─── Server ──────────────────────────────────────────────────────────────
PORT=8787
